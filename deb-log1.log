    2:  * distance, we assume the cache workingset is transitioning and put
    3:  * pressure on the current active list.
    4:  *
    5:  * If this is wrong and demotion kicks in, the pages which are truly
    6:  * used more frequently will be reactivated while the less frequently
    7:  * used once will be evicted from memory.
    8:  *
    9:  * But if this is right, the stale pages will be pushed out of memory
   10:  * and the used pages get to stay in cache.
   11:  *
   12:  *               Refaulting active pages
   13:  *
   14:  * If on the other hand the refaulting pages have recently been
   15:  * deactivated, it means that the active list is no longer protecting
   16:  * actively used cache from reclaim. The cache is NOT transitioning to
   17:  * a different workingset; the existing workingset is thrashing in the
   18:  * space allocated to the page cache.
   19:  *
   20:  *
   21:  *               Implementation
   22:  *
   23:  * For each node's file LRU lists, a counter for inactive evictions
   24:  * and activations is maintained (node->inactive_age).
   25:  *
   26:  * On eviction, a snapshot of this counter (along with some bits to
   27:  * identify the node) is stored in the now empty page cache radix tree
   28:  * slot of the evicted page.  This is called a shadow entry.
   29:  *
   30:  * On cache misses for which there are shadow entries, an eligible
   31:  * refault distance will immediately activate the refaulting page.
   32:  */
   33:
   34: #define EVICTION_SHIFT   (RADIX_TREE_EXCEPTIONAL_ENTRY + \
   35:                   1 + NODES_SHIFT + MEM_CGROUP_ID_SHIFT)
   36: #define EVICTION_MASK    (~0UL >> EVICTION_SHIFT)
   37:
   38: /*
   39:  * Eviction timestamps need to be able to cover the full range of
   40:  * actionable refaults. However, bits are tight in the radix tree
   41:  * entry, and after storing the identifier for the lruvec there might
   42:  * not be enough left to represent every single actionable refault. In
   43:  * that case, we have to sacrifice granularity for distance, and group
   44:  * evictions into coarser buckets by shaving off lower timestamp bits.
   45:  */
   46: static unsigned int bucket_order __read_mostly;
   47:
   48: static void *pack_shadow(int memcgid, pg_data_t *pgdat, unsigned long eviction,
   49:                   bool workingset)
   50: {
   51:  eviction >>= bucket_order;
   52:  eviction = (eviction << MEM_CGROUP_ID_SHIFT) | memcgid;
   53:  eviction = (eviction << NODES_SHIFT) | pgdat->node_id;
   54:  eviction = (eviction << 1) | workingset;
   55:  eviction = (eviction << RADIX_TREE_EXCEPTIONAL_SHIFT);
   56:
   57:  return (void *)(eviction | RADIX_TREE_EXCEPTIONAL_ENTRY);
   58: }
   59:
   60: static void unpack_shadow(void *shadow, int *memcgidp, pg_data_t **pgdat,
   61:                    unsigned long *evictionp, bool *workingsetp)
   62: {
   63:  unsigned long entry = (unsigned long)shadow;
   64:  int memcgid, nid;
   65:  bool workingset;
   66:
   67:  entry >>= RADIX_TREE_EXCEPTIONAL_SHIFT;
   68:  workingset = entry & 1;
   69:  entry >>= 1;
   70:  nid = entry & ((1UL << NODES_SHIFT) - 1);
   71:  entry >>= NODES_SHIFT;
   72:  memcgid = entry & ((1UL << MEM_CGROUP_ID_SHIFT) - 1);
   73:  entry >>= MEM_CGROUP_ID_SHIFT;
   74:
   75:  *memcgidp = memcgid;
   76:  *pgdat = NODE_DATA(nid);
   77:  *evictionp = entry << bucket_order;
   78:  *workingsetp = workingset;
   79: }
