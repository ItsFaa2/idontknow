   81: /**
   82:  * workingset_eviction - note the eviction of a page from memory
   83:  * @mapping: address space the page was backing
   84:  * @page: the page being evicted
   85:  *
   86:  * Returns a shadow entry to be stored in @mapping->page_tree in place
   87:  * of the evicted @page so that a later refault can be detected.
   88:  */
   89: void *workingset_eviction(struct address_space *mapping, struct page *page)
   90: {
   91:  struct pglist_data *pgdat = page_pgdat(page);
   92:  struct mem_cgroup *memcg = page_memcg(page);
   93:  int memcgid = mem_cgroup_id(memcg);
   94:  unsigned long eviction;
   95:  struct lruvec *lruvec;
   96:
   97:  /* Page is fully exclusive and pins page->mem_cgroup */
   98:  VM_BUG_ON_PAGE(PageLRU(page), page);
   99:  VM_BUG_ON_PAGE(page_count(page), page);
  100:  VM_BUG_ON_PAGE(!PageLocked(page), page);
  101:
  102:  lruvec = mem_cgroup_lruvec(pgdat, memcg);
  103:  eviction = atomic_long_inc_return(&lruvec->inactive_age);
  104:  return pack_shadow(memcgid, pgdat, eviction, PageWorkingset(page));
  105: }
